# More sensitive live demo preset.
# Use only if the stable preset misses the phone-screen drone target.

SOURCE=/dev/video48
MODEL_PATH=training_runs/drone_gpu_50e/weights/best.end2end_false.op12.rk3588.fp.v220.rknn
RTSP_MOUNT=/drone
WIDTH=640
HEIGHT=480
FPS=15
SCORE=0.20
NMS=0.45
RTSP_PORT=8554
DETECT_EVERY_N=3

RK_YOLO_PREPROCESS=opencv
RK_YOLO_PROFILE=0
RK_YOLO_ZERO_COPY_INPUT=0
RK_YOLO_INFER_WORKERS=1
RK_YOLO_DYNAMIC_ROI=0

RK_YOLO_TRACK_MODE=motion
RK_YOLO_BOX_SMOOTH=1
RK_YOLO_BOX_SMOOTH_ALPHA=0.40
RK_YOLO_BOX_SMOOTH_IOU=0.04
RK_YOLO_ALARM_OVERLAY=1
RK_YOLO_ALARM_HOLD_FRAMES=7

RK_YOLO_CAMERA_TUNE=1
RK_YOLO_CAMERA_MATCH="HBS Camera"
RK_YOLO_CAMERA_ZOOM=20
RK_YOLO_CAMERA_FOCUS_AUTO=0
RK_YOLO_CAMERA_FOCUS=260
RK_YOLO_CAMERA_SETTLE_MS=450
RK_YOLO_CAMERA_WARMUP_GRABS=8

RK_YOLO_AUTO_ZOOM=1
RK_YOLO_AUTO_ZOOM_MIN=10
RK_YOLO_AUTO_ZOOM_MAX=65
RK_YOLO_AUTO_ZOOM_STEP=6
RK_YOLO_AUTO_ZOOM_COOLDOWN=18
RK_YOLO_AUTO_ZOOM_LOST_FRAMES=60
RK_YOLO_AUTO_ZOOM_MIN_RATIO=0.08
RK_YOLO_AUTO_ZOOM_MAX_RATIO=0.26
