# Sensitive live demo preset with target-lock anti-jitter enabled.
# This is an experimental preset for phone-screen / printed-drone classroom demos.
# The stable demo presets are intentionally left unchanged.

SOURCE=/dev/video48
MODEL_PATH=training_runs/drone_gpu_50e/weights/best.end2end_false.op12.rk3588.fp.v220.rknn
RTSP_MOUNT=/drone
WIDTH=640
HEIGHT=480
FPS=15
SCORE=0.20
NMS=0.45
RTSP_PORT=8554
DETECT_EVERY_N=3

RK_YOLO_PREPROCESS=opencv
RK_YOLO_PROFILE=0
RK_YOLO_ZERO_COPY_INPUT=0
RK_YOLO_INFER_WORKERS=1
RK_YOLO_DYNAMIC_ROI=0

RK_YOLO_TRACK_MODE=motion
RK_YOLO_BOX_SMOOTH=1
RK_YOLO_BOX_SMOOTH_ALPHA=0.32
RK_YOLO_BOX_SMOOTH_IOU=0.03

# Lock onto one plausible target and limit per-frame center/size jumps.
RK_YOLO_TARGET_LOCK=1
RK_YOLO_LOCK_MIN_SCORE=0.24
RK_YOLO_LOCK_HOLD_FRAMES=15
RK_YOLO_LOCK_MIN_IOU=0.02
RK_YOLO_LOCK_MAX_CENTER_STEP=0.055
RK_YOLO_LOCK_MAX_SIZE_STEP=0.06
RK_YOLO_LOCK_ALPHA=0.24

RK_YOLO_ALARM_OVERLAY=1
RK_YOLO_ALARM_HOLD_FRAMES=7

RK_YOLO_CAMERA_TUNE=1
RK_YOLO_CAMERA_MATCH="HBS Camera"
RK_YOLO_CAMERA_ZOOM=20
RK_YOLO_CAMERA_FOCUS_AUTO=0
RK_YOLO_CAMERA_FOCUS=260
RK_YOLO_CAMERA_SETTLE_MS=450
RK_YOLO_CAMERA_WARMUP_GRABS=8

RK_YOLO_AUTO_ZOOM=1
RK_YOLO_AUTO_ZOOM_MIN=10
RK_YOLO_AUTO_ZOOM_MAX=75
RK_YOLO_AUTO_ZOOM_STEP=9
RK_YOLO_AUTO_ZOOM_COOLDOWN=12
RK_YOLO_AUTO_ZOOM_LOST_FRAMES=45
RK_YOLO_AUTO_ZOOM_MIN_RATIO=0.10
RK_YOLO_AUTO_ZOOM_MAX_RATIO=0.30
