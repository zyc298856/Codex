# Stable classroom live demo preset.
# Usage: bash defense_demo/scripts/run_live_safe.sh [camera_or_video_source]

SOURCE=/dev/video48
MODEL_PATH=training_runs/drone_gpu_50e/weights/best.end2end_false.op12.rk3588.fp.v220.rknn
RTSP_MOUNT=/drone
WIDTH=640
HEIGHT=480
FPS=15
SCORE=0.24
NMS=0.45
RTSP_PORT=8554
DETECT_EVERY_N=3

# Stable runtime path.
RK_YOLO_PREPROCESS=opencv
RK_YOLO_PROFILE=0
RK_YOLO_ZERO_COPY_INPUT=0
RK_YOLO_INFER_WORKERS=1
RK_YOLO_DYNAMIC_ROI=0

# Low-jitter display.
RK_YOLO_TRACK_MODE=motion
RK_YOLO_BOX_SMOOTH=1
RK_YOLO_BOX_SMOOTH_ALPHA=0.45
RK_YOLO_BOX_SMOOTH_IOU=0.05
RK_YOLO_ALARM_OVERLAY=1
RK_YOLO_ALARM_HOLD_FRAMES=5

# Camera startup tune and controlled zoom loop.
RK_YOLO_CAMERA_TUNE=1
RK_YOLO_CAMERA_MATCH="HBS Camera"
RK_YOLO_CAMERA_ZOOM=20
RK_YOLO_CAMERA_FOCUS_AUTO=0
RK_YOLO_CAMERA_FOCUS=260
RK_YOLO_CAMERA_SETTLE_MS=450
RK_YOLO_CAMERA_WARMUP_GRABS=8

RK_YOLO_AUTO_ZOOM=1
RK_YOLO_AUTO_ZOOM_MIN=10
RK_YOLO_AUTO_ZOOM_MAX=60
RK_YOLO_AUTO_ZOOM_STEP=5
RK_YOLO_AUTO_ZOOM_COOLDOWN=22
RK_YOLO_AUTO_ZOOM_LOST_FRAMES=75
RK_YOLO_AUTO_ZOOM_MIN_RATIO=0.07
RK_YOLO_AUTO_ZOOM_MAX_RATIO=0.24
